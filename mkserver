#!/bin/sh

rm -rf mods
mkdir mods

jq -c -r '.sync[] | select(.type == "mod")' sync.json \
  | while read -r line; do
    slug="$(printf '%s' "$line" | jq -r '.name')"
    url="$(printf '%s\n' "$line" | jq -r '.url')"
    version="$(printf '%s\n' "$line" | jq -r '.version')"

    env="$(wget -q -O - "https://api.modrinth.com/v2/project/$slug" | jq -r '.environment[]')"

    printf '%s' "$env" \
      | if grep 'server' > /dev/null; then
        (cd mods; wget -q -O "$slug-$version.jar" "$url")
        printf '%s\n' "downloaded $slug"
      fi
  done

# breaks server-side, isn't properly tagged
rm mods/toadlib-Ljldqqcx.jar

# non-modrinth mods
wget  -O mods/cosmetic-armor-reworked-1.jar \
  https://github.com/zlainsama/CosmeticArmorReworked/releases/download/1.21.1-v1-neoforge/cosmeticarmorreworked-1.21.1-v1-neoforge.jar

# server-side only mods
wget -O mods/justenoughbackups-jeb-2Kdl4TIp.jar \
  https://cdn.modrinth.com/data/ctV8T1ZK/versions/2Kdl4TIp/justenoughbackups-1.0.1.1%2B1.21.1.jar
